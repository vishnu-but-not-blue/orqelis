ENVIRONMENT=local
APP_NAME=Orqelis
BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./var/orqelis.db
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
STORAGE_PATH=var/objects
TED_ENABLED=true
TED_QUERY="publication-date >= 20260901"
TED_REQUESTS_PER_MINUTE=12
TED_CONCURRENCY=2
# Generate a secret for deployments; never commit it.
SECRET_KEY=
# Production only: scanner executable, e.g. clamscan --no-summary
MALWARE_COMMAND=
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_CONTACT=
LEGAL_JURISDICTION=
LEGAL_REVIEW_COMPLETE=false
BACKUPS_VERIFIED=false
BILLING_PROVIDER=disabled
# Email optional locally; SMTP uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
RETENTION_DAYS=30
